# Claude API key. Without it Saathi runs in demo mode with prepared AI answers.
ANTHROPIC_API_KEY=
# Model used for all AI features
SAATHI_MODEL=claude-opus-5-5
# How fast the emergency simulation runs (1 = real time; 20 = 1 real second is 20 simulated seconds)
DEMO_SPEED=20
PORT=3000
# Saathi voice call (Callvi's call engine). The Saathi agent is public but only answers from the allowed sites,
# so the app needs no key to call it. Override the agent here; set the key to use signed connections instead.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=
