{
  "name": "saathi",
  "private": true,
  "version": "1.0.0",
  "description": "Saathi: AI care companion and golden-hour emergency network for elders and their families",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx server/seed.ts --reset"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.0",
    "express": "4.21.2",
    "multer": "2.0.2",
    "socket.io": "4.8.1",
    "tsx": "4.19.2"
  },
  "devDependencies": {
    "@fontsource-variable/anek-latin": "^5.2.5",
    "@fontsource-variable/anek-tamil": "^5.2.5",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/hind-madurai": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@types/express": "4.17.21",
    "@types/leaflet": "1.9.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "framer-motion": "^11.18.2",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "postcss": "8.4.49",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-router-dom": "6.28.0",
    "recharts": "2.15.0",
    "socket.io-client": "4.8.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
